      "fonts": [
        {
          "bucket": "mono",
          "size": 12,
          "chars": 14
        }
      ]
    },
    {
      "text": "There were once nine thousand video rental stores in this country. There",
      "indent": 12,
      "y": 636,
      "pageNum": 1,
      "fonts": [
        {
          "bucket": "mono",
          "size": 12,
          "chars": 70
        }
