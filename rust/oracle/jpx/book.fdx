<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="2">
  <Content>
    <Paragraph Type="Scene Heading"><Text>INT. COLOUR TIMING BAY - NIGHT</Text></Paragraph>
    <Paragraph Type="Action"><Text>A reference print hangs under the loupe, one frame of it circled in grease pencil.</Text></Paragraph>
    <Paragraph Type="Character"><Text>WREN</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>The blue is two points cold and it has been all week.</Text></Paragraph>
    <Paragraph Type="Action"><Text>HOLT writes the number down without looking up.</Text></Paragraph>
    <Paragraph Type="Character"><Text>HOLT</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>Then we time it again.</Text></Paragraph>
  </Content>
