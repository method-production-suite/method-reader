[
  {
    "is_title": true,
    "type": "title",
    "text": "The Last Video Store"
  },
  {
    "is_title": true,
    "type": "credit",
    "text": "Written by"
  },
  {
    "is_title": true,
    "type": "author",
    "text": "A. N. Placeholder"
  },
  {
    "type": "scene_heading",
    "text": "INT. THE LAST VIDEO STORE - NIGHT"
  },
  {
    "type": "action",
    "text": "Fluorescent light hums over aisles of VHS tapes. Rain streaks the front window. A hand-lettered sign reads: EVERYTHING MUST GO."
  },
  {
    "type": "action",
    "text": "MARGO SHAW, 60s, cardigan with a pen through the pocket, alphabetizes a shelf that nobody will browse."
  },
  {
    "type": "action",
    "text": "The bell over the door RINGS."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "dialogue",
    "text": "We close at ten."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "parenthetical",
    "text": "(O.S.)"
  },
  {
    "type": "dialogue",
    "text": "It’s nine forty."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "DEV OKONKWO, 20s, soaked through, shakes off a jacket that was never waterproof."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "dialogue",
    "text": "And yet."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "dialogue",
    "text": "I need something for a fourteen- year-old who thinks movies started with streaming."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "Margo looks up for the first time."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "parenthetical",
    "text": "(a small conversion)"
  },
  {
    "type": "dialogue",
    "text": "Sit down."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "transition",
    "text": "> CUT TO:"
  },
  {
    "type": "scene_heading",
    "text": "INT. THE LAST VIDEO STORE - HORROR AISLE - CONTINUOUS"
  },
  {
    "type": "action",
    "text": "Margo moves like she’s done this ten thousand times, because she has. Dev trails her, dripping."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "dialogue",
    "text": "Fourteen. Scared, or pretending not to be?"
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "dialogue",
    "text": "Pretending. Loudly."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "synopsis",
    "text": "pg 2"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "dialogue",
    "text": "Then not the one with the mask. Everyone starts with the mask and nobody remembers it."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "She pulls a battered clamshell case and holds it like evidence."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO (CONT'D)"
  },
  {
    "type": "dialogue",
    "text": "This one. Nothing happens for forty minutes and then you never sleep facing a closet again."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "dialogue",
    "text": "That’s a pitch?"
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "dialogue",
    "text": "That’s a promise."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "transition",
    "text": "> DISSOLVE TO:"
  },
  {
    "type": "scene_heading",
    "text": "EXT. STRIP MALL - NIGHT"
  },
  {
    "type": "action",
    "text": "Rain. The store’s neon sign flickers between LAST and AST. Behind the glass, two silhouettes argue happily about something that doesn’t matter."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "parenthetical",
    "text": "(O.S.)"
  },
  {
    "type": "dialogue",
    "text": "How long have you been here?"
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "parenthetical",
    "text": "(O.S.)"
  },
  {
    "type": "dialogue",
    "text": "Since people still rewound."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "scene_heading",
    "text": "INT. THE LAST VIDEO STORE - COUNTER - LATER"
  },
  {
    "type": "action",
    "text": "A shoebox of index cards. Margo writes on one in careful block letters and slides it across."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "dialogue",
    "text": "What’s this?"
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "dialogue",
    "text": "Your card. Nineteen years running, four hundred and six members. You’re four hundred and seven."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "synopsis",
    "text": "pg 3"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "dialogue",
    "text": "You’re closing in a week."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "dialogue",
    "text": "Then it’ll be a short membership."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "Dev takes the card anyway. Pockets it like it matters, because it does."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "dialogue",
    "text": "What happens to all of it?"
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "Margo looks down the aisles. Twenty thousand tapes. A lifetime of other people’s Friday nights."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "dialogue",
    "text": "Somebody buys the shelves. The rest goes where the rest goes."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "dialogue",
    "text": "That’s grim."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "MARGO"
  },
  {
    "type": "parenthetical",
    "text": "(not grim at all)"
  },
  {
    "type": "dialogue",
    "text": "It’s Tuesday."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "transition",
    "text": "> SMASH CUT TO:"
  },
  {
    "type": "scene_heading",
    "text": "INT. DEV’S APARTMENT - NIGHT"
  },
  {
    "type": "action",
    "text": "A television old enough to have a dial. Dev threads the tape in. Static, then a countdown leader -- 5, 4, 3."
  },
  {
    "type": "action",
    "text": "His NIECE, 14, arms folded, sits as far from the screen as the room allows."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "NIECE"
  },
  {
    "type": "dialogue",
    "text": "This is going to be so boring."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "DEV"
  },
  {
    "type": "dialogue",
    "text": "Forty minutes. Give it forty minutes."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "synopsis",
    "text": "pg 4"
  },
  {
    "type": "action",
    "text": "The countdown hits 1. The room goes dark blue."
  },
  {
    "type": "action",
    "text": "Forty minutes later, she has not moved, and she is sitting considerably closer."
  },
  {
    "type": "transition",
    "text": "FADE OUT."
  }
]
