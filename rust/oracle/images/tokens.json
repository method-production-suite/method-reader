[
  {
    "is_title": true,
    "type": "title",
    "text": "The Paper Lantern"
  },
  {
    "is_title": true,
    "type": "credit",
    "text": "Written by"
  },
  {
    "is_title": true,
    "type": "author",
    "text": "J. Q. Nobody"
  },
  {
    "type": "note",
    "text": "img: p001-01.png w=100 full"
  },
  {
    "type": "scene_heading",
    "text": "INT. ARCHIVE ROOM - DAY"
  },
  {
    "type": "note",
    "text": "img: p002-01.png w=42"
  },
  {
    "type": "action",
    "text": "WREN, 30s, holds a storyboard panel up to the window and squints at it."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "WREN"
  },
  {
    "type": "dialogue",
    "text": "Somebody drew this in 1974 and nobody has looked at it since."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "HOLT sets down a box of film cans."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "HOLT"
  },
  {
    "type": "dialogue",
    "text": "That is the job."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "synopsis",
    "text": "pg 2"
  },
  {
    "type": "scene_heading",
    "text": "INT. ARCHIVE ROOM - PROJECTION BOOTH - LATER"
  },
  {
    "type": "action",
    "text": "A splice reel turns. The room smells of vinegar and dust."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "HOLT"
  },
  {
    "type": "dialogue",
    "text": "Two frames are missing from the head of the roll."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "WREN"
  },
  {
    "type": "dialogue",
    "text": "Then we cut around them."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "She threads the leader by feel, the way she was taught."
  },
  {
    "type": "synopsis",
    "text": "pg 3"
  },
  {
    "type": "scene_heading",
    "text": "EXT. LOADING DOCK - NIGHT"
  },
  {
    "type": "action",
    "text": "Rain on corrugated steel. WREN wheels a cart of film cans out under a sodium lamp and counts them twice."
  },
  {
    "type": "action",
    "text": "HOLT holds an umbrella over the cart and not over himself."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "WREN"
  },
  {
    "type": "dialogue",
    "text": "Forty-one. There were forty-three when we started."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "HOLT"
  },
  {
    "type": "dialogue",
    "text": "Two of them went out for repair in March and nobody wrote it down."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "WREN"
  },
  {
    "type": "dialogue",
    "text": "Nobody ever writes it down."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "She pulls a tarp over the cart and ties it at the corners."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "HOLT"
  },
  {
    "type": "dialogue",
    "text": "The truck comes at six. Everything on that manifest has to be on the dock by then, in order, and dry."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "WREN"
  },
  {
    "type": "dialogue",
    "text": "Then we work through it."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "The lamp buzzes and cuts out. Neither of them stops moving."
  },
  {
    "type": "action",
    "text": "In the dark the cart is a long shape and the rain is louder than it was."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "WREN (CONT'D)"
  },
  {
    "type": "dialogue",
    "text": "Bring the second cart. And the good tarp, not the one with the hole in it."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "action",
    "text": "Holt goes. Wren stands in the rain with a clipboard and does not hurry."
  },
  {
    "type": "synopsis",
    "text": "pg 4"
  },
  {
    "type": "scene_heading",
    "text": "INT. ARCHIVE ROOM - DAWN"
  },
  {
    "type": "action",
    "text": "The cart is gone. A single storyboard panel is still pinned to the window."
  },
  {
    "type": "dialogue_begin"
  },
  {
    "type": "character",
    "text": "WREN"
  },
  {
    "type": "dialogue",
    "text": "Leave that one."
  },
  {
    "type": "dialogue_end"
  },
  {
    "type": "transition",
    "text": "FADE OUT."
  }
]
