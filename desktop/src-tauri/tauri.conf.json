{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screepub",
  "version": "0.9.0",
  "identifier": "com.darkwell.screepub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Screepub",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://screepub-device-requests.samuelsandweiss.workers.dev"
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/screepub-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "publisher": "Darkwell Entertainment LLC",
    "category": "Productivity",
    "shortDescription": "Turn a screenplay PDF into a reflowable e-book.",
    "longDescription": "Screepub converts a screenplay PDF into an EPUB or MOBI that reflows properly on an e-reader, keeping cues with their dialogue and scenes with their headings, and copies the finished book onto a connected reader over USB.",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0RDA2NjhENTRGNkVCMzQKUldRMDYvWlVqV2JRNUQzRkpQMmVJZlQ4bTdaT2M5cmN2V05oVTJGdURUY0NwRDBRbEQ1c013UnYK",
      "endpoints": [
        "https://github.com/ssandweiss/screepub/releases/latest/download/latest.json"
      ]
    }
  }
}
